  "content": {
    "about.communityP1": "Marwa Crazy Cakes is proudly local, serving Milton and the greater Toronto area community with artistry backed by professionalism. Each creation is made with the highest standards of safety, quality, and care.",
    "about.communityTitle": "Established in Community, Guided by Excellence",
    "about.cta.contact": "Begin Your Cake Story",
    "about.cta.gallery": "See Our Work",
    "about.experienceP1": "At Marwa Crazy Cakes, every creation begins with a story worth celebrating. From cherished family milestones and intimate gatherings to unforgettable weddings, each cake is thoughtfully designed to reflect the people, memories, and moments that make every occasion special.",
    "about.experienceP2": "Marwa listens with care, develops inspired concepts, and transforms each vision into a refined work of edible art. With a personalized and attentive approach, she ensures that every detail feels meaningful—creating a memorable centerpiece made uniquely for your celebration.",
    "about.experienceTitle": "An Experience, Not Just a Cake",
    "about.eyebrow": "The artist, the story, the magic",
    "about.headline": "Marwa Hamama — The Artist Behind the Magic",
    "about.imageAlt": "Marwa Hamama, cake designer and sugar artist, founder of Marwa Crazy Cakes",
    "about.intro": "Every cake begins with a story. For Marwa Hamama, the cake artist and founder of Marwa Crazy Cakes in Milton, ON, that story is one of artistry, imagination, and devotion to craft. Her work spanning sculpted showpieces, towering wedding cakes, innovative cake art and contimporary sugar art has gained her recognition and wide spread acclaim across the local GTA area community and distinguished her as a premiere cake artist within the creative community.",
    "about.introItalic": "Marwa transforms cake design into an art form, weaving a unique story into every creation. Renowned for their graceful structures, exquisite detail, and thoughtful reflection of each celebration, her sugar masterpieces are truly unforgettable.",
    "about.quote": "Marwa Crazy Cakes isn't just about cake. It's about wonder, memory, and art that you can taste.",
    "about.title": "About Us",
    "contact.address": "Milton, ON, L9T 7C1",
    "contact.appBody": "Download the Marwa Crazy Cakes app for a seamless ordering experience.",
    "contact.appHeading": "Get Our App",
    "contact.appStoreLabel": "App Store",
    "contact.email": "livingnaturallymarwa@gmail.com",
    "contact.eyebrow": "Ready to bring your vision to life",
    "contact.followUs": "Follow Us",
    "contact.googlePlayLabel": "Google Play",
    "contact.intro": "Get in touch to discuss your custom cake needs. We're excited to be part of your special celebration.",
    "contact.phone": "416.902.5441",
    "contact.phoneHref": "14169025441",
    "contact.responseNote": "We'll respond to your inquiry within 24 hours. For urgent requests, please call us directly.",
    "contact.serviceArea": "Serving Milton, Toronto, Mississauga, Oakville, Brampton, Burlington and nearby GTA areas",
    "contact.sidebarHeading": "Get in Touch",
    "contact.title": "Let's Create Something Beautiful",
    "gallery.allCategory": "All",
    "gallery.categoriesLabel": "Gallery categories",
    "gallery.closeImage": "Close",
