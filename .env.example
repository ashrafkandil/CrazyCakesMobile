# Copy this file to .env.local and fill in your values. Never commit .env.local.
#
# EXPO_PUBLIC_ variables are inlined into the JavaScript bundle, so this key ships
# inside the app. Restrict it to the "Generative Language API" in Google Cloud and
# set per-key quotas so a leaked key can't run up a bill.

# Google Gemini API key (free): https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your-key-here

# Public base URL for the mobile-only content pack. Upload dist-content/ here.
# The app checks manifest.json on launch and when it returns to the foreground.
# EXPO_PUBLIC_MOBILE_CONTENT_URL=https://content.example.com/marwa-crazy-cakes

# Optional settings
# EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-lite-latest
# EXPO_PUBLIC_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com